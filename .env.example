NODE_ENV=development
PORT=4000

# Local dev: point at a local Mongo. In docker-compose this is overridden by
# the MONGODB_URI environment variable set in the root docker-compose.yml.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/commission_tracker?retryWrites=true&w=majority

# Generate a real secret before deploying, e.g.: openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=8h

# Must match the URL the frontend is actually served from.
CORS_ORIGIN=http://localhost:3000

# Used once by `npm run seed` to create the first Admin login. Leave blank to skip.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_me_now
SEED_ADMIN_NAME=Admin
